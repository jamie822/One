---
// LOCATION PAGES — the ranking engine.
//
// Every competitor studied produces near-identical location pages. Elite
// Electrical in Leeds runs five keyword variants of the same page; KHL
// Manchester uses one title template across every suburb. Both are thin-content
// risks and both read as machine-written.
//
// What makes these pages distinct is `landmarks` and `housingStock` in
// client.js — real streets and the real electrical characteristics of the local
// housing. If those are empty for a town, delete the town rather than ship a
// templated page.
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import TrustBar from '../../components/TrustBar.astro';
import Reviews from '../../components/Reviews.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { href, serviceSchema } from '../../lib/site.js';
import { client, services, areas, caseStudies } from '../../data/client.js';

export function getStaticPaths() {
  return areas.map((area) => ({ params: { slug: area.slug }, props: { area } }));
}

const { area } = Astro.props;
const path = `/areas/${area.slug}/`;
const jobHere = caseStudies.find((c) => c.area === area.slug);
const others = areas.filter((a) => a.slug !== area.slug).slice(0, 6);
---
<Layout
  path={path}
  title={`Electrician in ${area.name}`}
  description={`${client.name} — electrical work in ${area.name}. ${area.travelNote || ''} ${client.responsePromise}`}
  crumbs={[{ name: 'Home', path: '/' }, { name: 'Areas', path: '/areas/' }, { name: area.name, path }]}
  schemas={[serviceSchema(services[0], area.name)]}
>
  <Hero inner={true}>
    <p class="eyebrow">{area.name}</p>
    <h1>Electrician in {area.name}</h1>
    <p class="hero__sub">{area.travelNote}</p>
    <div class="hero__actions">
      <a class="btn btn--primary btn--lg" href={`tel:${client.phoneHref}`}>
        <Icon name="phone" /> {client.phone}
      </a>
      <a class="btn btn--ghost btn--lg" href={href('/contact/')}>Request a quote</a>
    </div>
  </Hero>

  <div class="container"><TrustBar /></div>

  <section class="section">
    <div class="container container--narrow reveal">
      <h2>Working in {area.name}</h2>

      {area.housingStock && <p class="lead">{area.housingStock}</p>}

      {area.landmarks?.length > 0 && (
        <p>
          We work regularly around {area.landmarks.slice(0, -1).join(', ')}
          {area.landmarks.length > 1 ? ' and ' : ''}{area.landmarks.at(-1)}.
        </p>
      )}

      {!area.housingStock && (
        <div class="ph" style="aspect-ratio:auto;padding:30px;margin:24px 0">
          <strong>This page is not ready to publish</strong>
          <small>
            Add `housingStock` and `landmarks` for {area.name} in src/data/client.js,
            or remove the area. A location page without local specifics is thin content.
          </small>
        </div>
      )}
    </div>
  </section>

  <section class="section section--panel">
    <div class="container">
      <div class="section__head reveal">
        <p class="eyebrow">Services</p>
        <h2>What we do in {area.name}</h2>
      </div>
      <div class="grid grid--3">
        {services.map((s, i) => (
          <a class="card reveal" style={`transition-delay:${(i % 3) * 80}ms`} href={href(`/services/${s.slug}/`)}>
            <span class="card__icon"><Icon name={s.icon} /></span>
            <h3>{s.title}</h3>
            <p>{s.short}</p>
            <span class="card__link">Read more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {jobHere && (
    <section class="section">
      <div class="container container--narrow reveal">
        <p class="eyebrow">A job in {area.name}</p>
        <h2>{jobHere.title}</h2>
        <p class="lead">{jobHere.problem}</p>
        <p>{jobHere.work}</p>
        <a class="btn btn--ghost" href={href(`/case-studies/${jobHere.slug}/`)}>See the full job</a>
      </div>
    </section>
  )}

  <section class="section section--panel">
    <div class="container">
      <div class="section__head reveal"><h2>Reviews</h2></div>
      <Reviews limit={3} />
    </div>
  </section>

  <section class="section">
    <div class="container reveal">
      <h2>Nearby</h2>
      <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:16px">
        {others.map((a) => <a class="pill" href={href(`/areas/${a.slug}/`)}>{a.name}</a>)}
      </div>
    </div>
  </section>

  <CtaBand title={`Need an electrician in ${area.name}?`} />
</Layout>
