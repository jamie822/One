---
import { client } from '../data/client.js';
import { href } from '../lib/site.js';
import Icon from './Icon.astro';

const {
  title = `Need an electrician in ${client.address.locality}?`,
  text = client.responsePromise,
} = Astro.props;
---
<section class="cta">
  <div class="cta__inner reveal">
    <h2>{title}</h2>
    <p class="lead">{text}</p>
    <div class="cta__actions">
      <a class="btn btn--primary btn--lg" href={`tel:${client.phoneHref}`}>
        <Icon name="phone" /> {client.phone}
      </a>
      <a class="btn btn--ghost btn--lg" href={href('/contact/')}>Request a quote</a>
    </div>
  </div>
</section>

<style>
  .cta .btn svg { width: 18px; height: 18px; }
</style>
