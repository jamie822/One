---
import { client } from '../data/client.js';
import { hasRating } from '../lib/site.js';
import Icon from './Icon.astro';

const stars = hasRating ? '★'.repeat(Math.round(client.google.rating)) : '';
---
<div class="trustbar">
  {hasRating && (
    <span class="trustbar__item">
      <span class="stars">{stars}</span>
      <strong>{client.google.rating}</strong>
      from {client.google.reviewCount} Google reviews
    </span>
  )}

  {client.otherPlatforms.map((p) => (
    <span class="trustbar__item">
      <strong>{p.score}</strong> on {p.name}{p.count ? ` (${p.count})` : ''}
    </span>
  ))}

  {client.accreditations.filter((a) => a.name).map((a) => (
    <span class="trustbar__item">
      <Icon name="shield" style="width:16px;height:16px" />
      {a.url ? <a href={a.url} rel="noopener" target="_blank">{a.name}</a> : a.name}
      {a.number && <span>#{a.number}</span>}
    </span>
  ))}

  {client.owner.yearsTrading && (
    <span class="trustbar__item"><strong>{client.owner.yearsTrading} years</strong> trading</span>
  )}

  {client.insurance && (
    <span class="trustbar__item">{client.insurance}</span>
  )}
</div>

<style>
  .trustbar__item svg { width: 16px; height: 16px; color: var(--brand); flex: 0 0 auto; }
</style>
