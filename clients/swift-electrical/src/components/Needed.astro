---
// Renders an obvious inline gap wherever client data is missing.
//
// The point is that a missing fact should be VISIBLE in review, not silently
// absent and not quietly invented. These must all be gone before launch —
// `npm run build` prints a count.
const { label } = Astro.props;
---
<span class="needed" title="Needs client input before launch">{label}</span>

<style>
  .needed {
    display: inline-block;
    padding: 2px 9px;
    border: 1px dashed var(--brand);
    border-radius: 5px;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--brand);
    background: var(--brand-soft);
    white-space: nowrap;
  }
</style>
