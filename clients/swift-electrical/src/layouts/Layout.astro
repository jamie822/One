---
import { client } from '../data/client.js';
import { href, businessSchema, breadcrumbSchema, ratingLabel, hasPhone } from '../lib/site.js';
import Needed from '../components/Needed.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const {
  title,
  description,
  path = '/',
  // Pass an array of { name, path } to emit BreadcrumbList schema + a visible trail.
  crumbs = null,
  // Extra JSON-LD blocks (Service, FAQPage, …)
  schemas = [],
} = Astro.props;

const canonical = new URL(path, client.url).href;

// Rating in the title lifts click-through on every listing the client owns.
// Only appended when the rating is genuine — see lib/site.js.
const suffix = ratingLabel ? ` | ${client.name} · ${ratingLabel}` : ` | ${client.name}`;
const fullTitle = title ? `${title}${suffix}` : `${client.name} — ${client.tagline}`;
const metaDesc = description || client.tagline;

const allSchemas = [businessSchema(), ...(crumbs ? [breadcrumbSchema(crumbs)] : []), ...schemas];
---
<!doctype html>
<html
  lang="en-GB"
  data-mode={client.mode}
  style={`--brand:${client.brandColor};--brand-dark:${client.brandColorDark};--brand-soft:color-mix(in srgb, ${client.brandColor} 12%, transparent);`}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={client.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={href('/sitemap-index.xml')} />

    <!-- Fonts are self-hosted. No third-party request, nothing render-blocking,
         and the page cannot silently fall back if a CDN is slow or blocked. -->
    <link rel="preload" as="font" type="font/woff2" href={href('/fonts/sora-latin-800-normal.woff2')} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={href('/fonts/inter-latin-400-normal.woff2')} crossorigin />

    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <!-- The page's one authored motion moment: a live circuit down the page,
         filling as you scroll. Decorative, so hidden from assistive tech. -->
    <div class="spine" aria-hidden="true">
      <div class="spine__fill" data-spine-fill></div>
      <div class="spine__head" data-spine-head></div>
    </div>
    <Header path={path} />

    {crumbs && crumbs.length > 1 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <div class="container">
          {crumbs.map((c, i) => (
            <>
              {i > 0 && <span>/</span>}
              {i === crumbs.length - 1
                ? <span aria-current="page">{c.name}</span>
                : <a href={href(c.path)}>{c.name}</a>}
            </>
          ))}
        </div>
      </nav>
    )}

    <main id="main"><slot /></main>

    <!-- Mobile action bar. Roughly 70% of this audience is on a phone, and
         contact details outrank price and reviews as a trust factor. -->
    <div class="callbar">
      {hasPhone
        ? <a class="btn btn--act" href={`tel:${client.phoneHref}`}>Call {client.phone}</a>
        : <Needed label="PHONE NEEDED" />}
      <a class="btn btn--ghost" href={href('/contact/')}>Get a price</a>
    </div>
    <Footer />

    <script>
      // Header border on scroll.
      const header = document.querySelector('.header');
      const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Mobile nav.
      const toggle = document.querySelector('.nav-toggle');
      const nav = document.querySelector('.nav');
      toggle?.addEventListener('click', () => {
        const open = nav?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(Boolean(open)));
      });

      // Spine: fills as the page scrolls. rAF-throttled so the scroll handler
      // never blocks; skipped entirely under reduced-motion.
      const fill = document.querySelector('[data-spine-fill]');
      const head = document.querySelector('[data-spine-head]');
      if (fill && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        let ticking = false;
        const draw = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const pct = max > 0 ? Math.min(1, window.scrollY / max) : 0;
          const h = pct * window.innerHeight;
          fill.style.height = h + 'px';
          if (head) head.style.top = h + 'px';
          ticking = false;
        };
        window.addEventListener('scroll', () => {
          if (!ticking) { ticking = true; requestAnimationFrame(draw); }
        }, { passive: true });
        draw();
      }

      // Scroll reveal. IntersectionObserver only — no scroll handler, so this
      // costs nothing on the main thread and cannot hurt INP.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll('.reveal');
      if (reduce || !('IntersectionObserver' in window)) {
        items.forEach((el) => el.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          }),
          { threshold: 0.1, rootMargin: '0px 0px -40px' }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
