---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Reviews from '../components/Reviews.astro';
import CtaBand from '../components/CtaBand.astro';
import Placeholder from '../components/Placeholder.astro';
import Needed from '../components/Needed.astro';
import Icon from '../components/Icon.astro';
import { href, hasRating, hasPhone } from '../lib/site.js';
import { client, services, areas, faqs } from '../data/client.js';

// The two the reviews actually evidence lead the section at full size.
const lead = services.filter((s) => ['eicr-landlord-certificates', 'cctv-security'].includes(s.slug));
const rest = services.filter((s) => !lead.includes(s));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.filter((f) => f.a).map((f) => ({
    '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout
  path="/"
  title="Electrician in Bradford"
  description="Swift Electrical & Security. NICEIC registered electrician and security installer covering Bradford and West Yorkshire. EICRs, fault finding, CCTV, lighting. 5.0 from 7 Google reviews."
  schemas={[faqSchema]}
>
  <Hero>
    {hasRating && (
      <p class="rise" style="margin:0 0 16px;display:flex;align-items:center;gap:10px;flex-wrap:wrap">
        <span class="stars" style="color:var(--accent)">{'★'.repeat(Math.round(client.google.rating))}</span>
        <strong style="font-family:var(--font-display)">{client.google.rating}</strong>
        <span class="muted">from {client.google.reviewCount} Google reviews</span>
      </p>
    )}
    <h1 class="rise">Electrician &amp; security installer in Bradford</h1>
    <h2 class="hero__strapline rise"><span class="hl">Swift</span> on the job. Straight on the price.</h2>
    <p class="hero__sub rise">
      NICEIC registered, covering Bradford and across West Yorkshire. Landlord
      EICRs, fault finding, CCTV and alarms, lighting and rewires. Electrical
      work and security from the same pair of hands.
    </p>
    <div class="hero__actions rise">
      {hasPhone
        ? <a class="btn btn--act btn--lg" href={`tel:${client.phoneHref}`}><Icon name="phone" /> {client.phone}</a>
        : <Needed label="PHONE NUMBER NEEDED — add to Google too" />}
      <a class="btn btn--ghost btn--lg" href={href('/contact/')}>Get a price</a>
    </div>
  </Hero>

  <div class="container"><TrustBar /></div>

  <!-- WHAT THE BUSINESS ACTUALLY IS -->
  <section class="section">
    <div class="container container--narrow">
      <div class="reveal">
        <h2>Two trades, one van</h2>
        <p class="lead" style="color:var(--brand)">
          Most people land here because someone gave them our name and they want
          to check we are real. So, briefly, this is what we do.
        </p>
        <p class="lead">
          Swift Electrical &amp; Security does the wiring and the security. Most
          electricians stop at the consumer unit and hand you to a separate firm
          for cameras; most alarm companies are not qualified to touch a
          circuit. Doing both means one visit, and one person who knows where the cables
          run when something stops working.
        </p>
        <p class="muted">
          The bulk of the work is domestic and landlord: EICR inspections and
          certificates, fault finding, fuse board replacements, extra sockets,
          indoor and outdoor lighting, and full or partial rewires. On the
          security side it is camera systems, alarms, door entry and floodlights
          Specified for the property rather than pulled off a shelf.
        </p>
        <p class="muted">
          We test to BS 7671 and certify the work. Notifiable jobs go to Building
          Control, so you hold the compliance paperwork your solicitor asks for
          the day you sell.
        </p>
      </div>

      <div class="inline-cta reveal">
        <p>Not sure which of those you need?</p>
        <a class="btn btn--act" href={href('/contact/')}>Describe the job <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- SERVICES: asymmetric. The two the reviews evidence lead. -->
  <section class="section section--panel">
    <div class="container">
      <div class="section__head reveal">
        <h2>What we get called out for most</h2>
        <p>Ordered by what people book most.</p>
      </div>

      <div class="svc-lead">
        {lead.map((s, i) => (
          <a class={`svc-hero reveal ${i === 0 ? 'reveal--left' : 'reveal--right'}`} href={href(`/services/${s.slug}/`)}>
            <span class="svc-hero__tag">{s.slug === 'cctv-security' ? 'The half nobody else does' : 'Most booked'}</span>
            <h3>{s.title}</h3>
            <p>{s.symptom}</p>
            <span class="svc-hero__go">See how it works <Icon name="arrow" /></span>
          </a>
        ))}
      </div>

      <div class="svc-list reveal">
        {rest.map((s) => (
          <a class="svc-row" href={href(`/services/${s.slug}/`)}>
            <span class="svc-row__ico"><Icon name={s.icon} /></span>
            <span>
              <h3>{s.title}</h3>
              <p>{s.short}</p>
            </span>
            <span class="svc-row__arrow"><Icon name="arrow" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- PROOF -->
  <section class="section">
    <div class="container">
      <div class="stats reveal">
        <div class="stat"><div class="stat__n">{client.google.rating}</div><div class="stat__l">Google rating</div></div>
        <div class="stat"><div class="stat__n">{client.google.reviewCount}</div><div class="stat__l">Reviews, every one 5&#9733;</div></div>
        <div class="stat"><div class="stat__n">2</div><div class="stat__l">Trades under one roof</div></div>
        <div class="stat"><div class="stat__n">8pm</div><div class="stat__l">We answer until</div></div>
      </div>
    </div>
  </section>

  <!-- THE OWNER -->
  <section class="section section--panel">
    <div class="container split">
      <div class="frame reveal reveal--left">
        <Placeholder
          src={client.owner.photo}
          alt={`${client.owner.name} of ${client.name}`}
          label="Photo of Adil needed"
          hint="A real photo, even one off a phone. This is the highest-trust image on the site and there is nothing here yet."
          variant="ph--portrait"
        />
      </div>
      <div class="reveal reveal--right">
        <h2>You'll be dealing with Adil</h2>
        <p class="lead">{client.owner.bio}</p>
        <p class="muted">
          Three of the seven reviews name him. One customer had the power
          tripping constantly and had already had several electricians out.
          None of them found it. Another customer had Adil drive forty minutes out of his way to sort a
          lighting fault.
        </p>
        <p><Needed label="Adil's surname, years trading, qualifications" /></p>
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:22px">
          <a class="btn btn--act" href={href('/contact/')}>Get a price <Icon name="arrow" /></a>
          <a class="btn btn--ghost" href={href('/about/')}>More about us</a>
        </div>
      </div>
    </div>
  </section>

  <!-- REVIEWS CAROUSEL -->
  <section class="section">
    <div class="container">
      <div class="section__head reveal">
        <h2>Seven reviews. Seven fives.</h2>
        <p>Copied from Google word for word, including the typos.</p>
      </div>
      <div class="reveal"><Reviews /></div>
    </div>
  </section>

  <!-- AREAS -->
  <section class="section section--panel">
    <div class="container">
      <div class="section__head reveal">
        <h2>Where we work</h2>
        <p>Bradford and out across the Aire valley. Each area page says what we find in that housing stock.</p>
      </div>
      <div class="reveal" style="display:flex;flex-wrap:wrap;gap:10px">
        {areas.map((a) => (
          <a class="pill" href={href(`/areas/${a.slug}/`)}>{a.name}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container container--narrow">
      <div class="section__head reveal">
        <h2>Straight answers</h2>
        <p>Including the one about EICR codes that stops you being sold work you don't need.</p>
      </div>
      <div class="faq reveal">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <div class="faq__body">{f.a || <Needed label="ANSWER NEEDED" />}</div>
          </details>
        ))}
      </div>
      <div class="inline-cta reveal">
        <p>Still not sure? Ask and we'll tell you straight.</p>
        <a class="btn btn--act" href={href('/contact/')}>Ask a question <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <CtaBand title="Want a price?" />
</Layout>
