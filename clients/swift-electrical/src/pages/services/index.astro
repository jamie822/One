---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import TrustBar from '../../components/TrustBar.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { href, primaryArea, itemListSchema } from '../../lib/site.js';
import { client, services } from '../../data/client.js';

const listed = services.map((s) => ({ name: s.title, path: `/services/${s.slug}/` }));

/* Was advertising "EV chargers", which appears nowhere in client.js and nowhere
   in the six services this site sells. Promising a service in the snippet that
   the page does not deliver is the cheapest way there is to lose the click and
   the trust behind it. The six below are the six that exist. */
const metaDesc =
  `EICRs and landlord certificates, fault finding, CCTV and alarms, lighting, ` +
  `consumer units, rewiring. NICEIC registered, ${primaryArea.name} and ${client.address.region}.`;
---
<Layout
  path="/services/"
  title="Electrical services"
  description={metaDesc}
  crumbs={[{ name: 'Home', path: '/' }, { name: 'Services', path: '/services/' }]}
  schemas={[itemListSchema(`Services from ${client.name}`, listed)]}
>
  <Hero inner={true}>
    <p class="eyebrow">Services</p>
    <h1>What we do</h1>
    <p class="hero__sub">Domestic and commercial electrical work across {client.address.region}.</p>
  </Hero>

  <div class="container"><TrustBar /></div>

  <section class="section">
    <div class="container">
      <div class="grid grid--2">
        {services.map((s, i) => (
          <a class="card reveal" style={`transition-delay:${(i % 2) * 80}ms`} href={href(`/services/${s.slug}/`)}>
            <span class="card__icon"><Icon name={s.icon} /></span>
            <h3>{s.title}</h3>
            <p>{s.symptom}</p>
            <span class="card__link">Read more →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Layout>
