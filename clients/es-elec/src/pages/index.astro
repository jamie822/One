---
// HOME. Copy comes from COPY.md verbatim; figures from client.js, TEMP-tagged.
import Base from '../layouts/Base.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { client } from '../data/client.js';

const tel = client.phone.replace(/\s/g, '');
// Solar leads the ticker: it is the service the client wants more of, and the
// first frame a visitor reads.
const CYCLE = ['Solar', 'EV chargers', 'Rewires', 'Fuse boards', 'EICRs', 'Fault finding'];

const fmt = (n) => '£' + n.toLocaleString('en-GB');
const svc = Object.fromEntries(client.services.map((s) => [s.id, s]));

const stars = Array.from({ length: 5 });
---
<!-- DIRECTION CONTRACT
THESIS: the electrician who prices before work starts, staged as a lit workshop
at night; refuses the trade-blue hero-metric template.
OWN-WORLD: Tungsten. Warm charcoal ground, filament amber reserved for
conversion, Clash Display over Satoshi, one conductor line drawn by scroll,
paper-lit middle sections between dark bookends.
STORY: arrive at night needing help, see the promise and the price culture,
read proof on paper in daylight, leave by phone or form.
FIRST VIEWPORT: left, kinetic service line over a two-line H1 and 18-word sub,
Call Eddie (lit) beside Get a quote; right, the van at dusk photograph.
Trust bar closes the viewport.
FORM: brief-pinned Tungsten (ledger 2026-07-28), kinetic-type masthead staging,
seed n/a: direction pinned by founder brief, not rolled. -->
<Base
  title="Electrician in Leeds | Rewires, EV & Solar | ES Elec"
  description={`NICEIC registered electrician in Leeds. Rewires, fuse boards, EICRs, EV chargers and solar, priced before work starts. Call Eddie on ${client.phone}.`}
  current="/"
  preloadImage="/img/van-dusk-1080.webp"
  preloadSrcset="/img/van-dusk-720.webp 720w, /img/van-dusk-1080.webp 1080w, /img/van-dusk.webp 1400w"
  preloadSizes="100vw"
>
  <section class="hero hero--film">
    {/* The whole hero is the film: the dusk street slow-pans, live current
        runs the traces, embers drift off the work. Content sits in the
        scrimmed left third. TEMP footage slot: when Higgsfield is back, a
        generated dusk video loop drops in behind the same scrim. */}
    <div class="hero__scene" aria-hidden="true">
      <img
        class="hero__film"
        src="/img/van-dusk-1080.webp"
        srcset="/img/van-dusk-720.webp 720w, /img/van-dusk-1080.webp 1080w, /img/van-dusk.webp 1400w"
        sizes="100vw"
        alt=""
        width="1400" height="781" fetchpriority="high" decoding="async"
        data-film
      />
      <div class="hero__scrim"></div>
      <svg class="hero__traces" viewBox="0 0 1440 760" preserveAspectRatio="xMidYMid slice">
        <path class="trace" d="M-20 640 H 300 Q 316 640 316 624 V 420 Q 316 404 332 404 H 700" />
        <path class="trace" d="M1460 180 H 1080 Q 1064 180 1064 196 V 520 Q 1064 536 1048 536 H 820" />
        <path class="trace" d="M-20 120 H 190 Q 206 120 206 136 V 300" />
        <path class="pulse pulse--a" d="M-20 640 H 300 Q 316 640 316 624 V 420 Q 316 404 332 404 H 700" />
        <path class="pulse pulse--b" d="M1460 180 H 1080 Q 1064 180 1064 196 V 520 Q 1064 536 1048 536 H 820" />
        <path class="pulse pulse--c" d="M-20 120 H 190 Q 206 120 206 136 V 300" />
      </svg>
      <canvas class="hero__embers" data-embers></canvas>
    </div>

    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="hero__cycle" aria-hidden="true">
          {CYCLE.map((w, n) => <span style={`--n:${n}`}>{w}</span>)}
        </p>
        <h1>The Leeds electrician who <span class="hero__hl">prices the job</span> before it starts.</h1>
        <p class="hero__sub">
          No surprises on the invoice. The bloke who answers the phone quotes
          the job and does the work.
        </p>
        <div class="hero__acts">
          <a class="btn btn--call btn--lit" href={`tel:${tel}`}>Call Eddie</a>
          <a class="btn btn--quote" href="#quote">Get a quote</a>
        </div>
        {client.emergency && (
          <p class="hero__urgent">
            <span class="hero__urgent-dot" aria-hidden="true"></span>
            Something dead or tripping right now? Ring: emergencies jump the queue. <!-- TEMP promise -->
          </p>
        )}
      </div>
      <span class="hero__chip hero__chip--a" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2 4 14h6l-2 8 9-12h-6z"/></svg>
        NICEIC Approved <!-- TEMP -->
      </span>
      <span class="hero__chip hero__chip--b" aria-hidden="true">
        Out across Leeds, {client.hours} <!-- TEMP -->
      </span>
    </div>

    <div class="hero__marquee" aria-hidden="true">
      <div class="hero__marquee-track">
        {Array.from({ length: 2 }).map(() => (
          <>
            <span>NICEIC Approved Contractor</span><i>/</i>
            <span>Tested to BS 7671</span><i>/</i>
            <span>Notified to Building Control</span><i>/</i>
            <span>Priced before work starts</span><i>/</i>
            <span>£2m insured</span><i>/</i>
            <span>Leeds and the towns around it</span><i>/</i>
          </>
        ))}
      </div>
    </div>
  </section>

  <section class="trust" aria-label="Credentials">
    <div class="wrap trust__row">
      <p class="trust__item">
        <strong>
          <span class="trust__stars" aria-hidden="true">
            {stars.map(() => (
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.6 7.1.7-5.4 4.8 1.6 7L12 17.5 5.8 21l1.6-7L2 9.3l7.1-.7z"/></svg>
            ))}
          </span>
          <span data-count={client.google.rating}>{client.google.rating}</span>
        </strong>
        <span>from <span data-count={client.google.reviewCount}>{client.google.reviewCount}</span> Google reviews</span>
      </p>
      <p class="trust__item"><strong>NICEIC</strong><span>Approved Contractor</span></p>
      <p class="trust__item"><strong>£2m</strong><span>public liability</span></p>
      <p class="trust__item"><strong>Since {client.founded}</strong><span>trading in Leeds</span></p>
    </div>
  </section>

  <div style="position: relative;">
    <div class="conductor" aria-hidden="true"></div>

    <section class="section work" aria-labelledby="work-h">
      <div class="wrap">
        <h2 id="work-h" class="rise">What I can sort for you</h2>
        <div class="work__grid">
          <a class="work__cell work__cell--lead rise" style="--i:0" href="/services/#solar">
            <span class="work__img">
              <img src="/img/solar-dusk-1100.webp" alt="" width="800" height="450" loading="lazy" />
            </span>
            <span class="work__body">
              <h3>Solar and battery</h3>
              <p>Sized on a year of your bills, with the payback maths in writing.</p>
              <span class="from">From {fmt(svc.solar.from)}</span>
            </span>
          </a>
          <a class="work__cell rise" style="--i:1" href="/services/#ev">
            <h3>EV chargers</h3>
            <p>Fitted, certified, grant paperwork handled.</p>
            <span class="from">From {fmt(svc.ev.from)}</span>
          </a>
          <a class="work__cell rise" style="--i:2" href="/services/#rewires">
            <h3>Rewires</h3>
            <p>Priced room by room before a floorboard lifts.</p>
            <span class="from">From {fmt(svc.rewires.from)}</span>
          </a>
          <a class="work__cell rise" style="--i:3" href="/services/#boards">
            <h3>Fuse boards</h3>
            <p>Swapped in a day, certificate in your hand.</p>
            <span class="from">From {fmt(svc.boards.from)}</span>
          </a>
          <a class="work__cell rise" style="--i:4" href="/services/#eicr">
            <h3>EICRs</h3>
            <p>Booked this week, report in plain English.</p>
            <span class="from">From {fmt(svc.eicr.from)}</span>
          </a>
          <a class="work__cell work__cell--wide rise" style="--i:5" href="/services/#fault">
            <h3>Fault finding</h3>
            <p>Traced with test gear, fixed the same visit where parts allow.</p>
            <span class="from">From {fmt(svc.fault.from)}</span>
          </a>
          <a class="work__cell work__cell--wide rise" style="--i:6" href="/services/#lighting">
            <h3>Lighting</h3>
            <p>Design and fitting, indoors and out.</p>
            <span class="from">From {fmt(svc.lighting.from)}</span>
          </a>
        </div>
      </div>
    </section>

    <div class="paper">
      <section class="section" aria-labelledby="proof-h">
        <div class="wrap">
          <h2 id="proof-h" class="rise">Priced before it starts. Certified when it's done.</h2>
          <p class="rise" style="margin-top: var(--s-3); color: var(--ink-soft);">
            Every job gets a written price before work begins. If I open a wall
            and find a horror, we talk before anything changes. Every notifiable
            job is registered with Building Control and you get the certificate.
          </p>
          <div class="proof__cols">
            <div class="proof__point rise" style="--i:0">
              <strong>Same person, start to finish</strong>
              <p>The one who quotes is the one on the tools.</p>
            </div>
            <div class="proof__point rise" style="--i:1">
              <strong>Written price first</strong>
              <p>The number you agree is the number you pay.</p>
            </div>
            <div class="proof__point rise" style="--i:2">
              <strong>Certificates, always</strong>
              <p>NICEIC registered, Part P notified, tested to BS 7671.</p>
            </div>
            <div class="proof__point rise" style="--i:3">
              <strong>Tidy</strong>
              <p>Dust sheets down, rubbish gone, sockets wiped.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="rev-h" style="padding-top: 0;">
        <div class="wrap">
          <h2 id="rev-h" class="rise">Word for word</h2>
          <div class="reviews__grid">
            <article class="review review--lead rise">
              <p class="stars" role="img" aria-label="Five stars">
                {stars.map(() => (
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l2.9 6.6 7.1.7-5.4 4.8 1.6 7L12 17.5 5.8 21l1.6-7L2 9.3l7.1-.7z"/></svg>
                ))}
              </p>
              <blockquote>Found the intermittent fault two other firms had guessed at. Charged the hour he quoted.</blockquote>
              <footer>Dawn, Horsforth. Fault finding, June 2026 <!-- TEMP demo review --></footer>
            </article>
            <div class="reviews__side">
              <article class="review rise" style="--i:1">
                <blockquote>Rewire of our 3-bed while we were in it. Rooms back together each night, price never moved.</blockquote>
                <footer>Marcus, Garforth. Full rewire, April 2026 <!-- TEMP demo review --></footer>
              </article>
              <article class="review rise" style="--i:2">
                <blockquote>Fitted the charger three days after I rang. Sorted the paperwork for the grant too.</blockquote>
                <footer>Priya, Headingley. EV charger, May 2026 <!-- TEMP demo review --></footer>
              </article>
            </div>
          </div>
          <a class="reviews__all" href="https://www.google.com/maps" rel="noopener">
            Read all {client.google.reviewCount} reviews on Google
          </a><!-- TEMP review link: swap for the client's real Google reviews URL -->
        </div>
      </section>

      <section class="section" aria-labelledby="area-h" style="padding-top: 0;">
        <div class="wrap">
          <h2 id="area-h" class="rise">Leeds and the towns around it</h2>
          <p class="rise" style="margin-top: var(--s-2); color: var(--ink-soft);">
            Based in {client.town}, out daily across {client.areas.slice(1, -1).join(', ')} and
            {' '}{client.areas.at(-1)}. If you are just outside that, ring anyway.
            The answer is usually yes.
          </p>
        </div>
      </section>

      <section class="section" aria-labelledby="solar-h" style="padding-top: 0;">
        <div class="wrap">
          <h2 id="solar-h" class="rise">Thinking about solar? Do the maths first.</h2>
          <div class="solar__grid">
            <figure class="solar__photo rise">
              <img src="/img/solar-dusk-1100.webp" alt="Solar panels on a red brick semi at golden hour" width="1600" height="900" loading="lazy" />
            </figure>
            <div class="rise" style="--i:1">
              <p>
                Most 10-panel systems on a Leeds semi come in between £6,000 and
                £8,000 installed. Payback lives or dies on sizing the system to
                how you use electricity. Send me two bills and I will tell you
                straight whether your roof is worth it, including when the
                answer is no. <!-- TEMP figures -->
              </p>
              <svg class="flow" viewBox="0 0 410 58" width="410" height="58" role="img"
                   aria-label="Energy flows from the roof panels through the battery to the house">
                <path d="M8 46 C 90 46, 120 12, 208 12 S 330 46, 402 46" />
                <circle class="dot" r="3.5" />
                <circle class="dot" r="3.5" />
                <circle class="dot" r="3.5" />
                <text x="4" y="34">PANELS</text>
                <text x="182" y="30">BATTERY</text>
                <text x="368" y="34">HOUSE</text>
              </svg>
              <div style="margin-top: var(--s-3);">
                <a class="btn btn--quote" href="#quote">Get a quote</a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>

    <section class="section contact" id="quote" aria-labelledby="contact-h">
      <div class="wrap">
        <h2 id="contact-h" class="rise">Ring now, or get a written price by tomorrow.</h2>
        <div class="contact__grid">
          <div class="rise contact__info">
            <a class="contact__tel" href={`tel:${tel}`}>{client.phone}</a>
            <p class="contact__hours">
              {client.hours}. Out of hours, leave a message and I call back
              first thing.
            </p>
            <p class="contact__areas">
              Out daily across {client.areas.slice(0, -1).join(', ')} and
              {' '}{client.areas.at(-1)}.
            </p>
            <ul class="contact__facts">
              <li>Prefer email? <a href={`mailto:${client.email}`}>{client.email}</a></li>
              <li>{client.accreditation}, number {client.accreditationNumber} <!-- TEMP --></li>
              <li>{client.guarantee} and {client.liabilityCover} behind every job <!-- TEMP --></li>
            </ul>
          </div>
          <QuoteForm />
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    // The embers: sparks off the night's work, drifting up through the hero.
    // Starts after load so it never touches LCP; skips itself entirely under
    // reduced motion; pauses when the tab is hidden.
    window.addEventListener('load', function () {
      var c = document.querySelector('[data-embers]');
      if (!c || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var x = c.getContext('2d');
      var dpr = Math.min(devicePixelRatio || 1, 2);
      var W, H;
      function size() { W = c.width = c.offsetWidth * dpr; H = c.height = c.offsetHeight * dpr; }
      size();
      addEventListener('resize', size);
      var N = innerWidth < 800 ? 14 : 34;
      function spawn(anywhere) {
        return {
          x: Math.random() * W,
          y: anywhere ? Math.random() * H : H + 12,
          r: (Math.random() * 1.5 + 0.6) * dpr,
          v: (Math.random() * 0.4 + 0.16) * dpr,
          ph: Math.random() * 6.28,
          sway: (Math.random() * 0.5 + 0.15) * dpr,
          a: Math.random() * 0.42 + 0.14,
        };
      }
      var ps = [];
      for (var i = 0; i < N; i++) ps.push(spawn(true));
      var running = true;
      document.addEventListener('visibilitychange', function () {
        running = !document.hidden;
        if (running) requestAnimationFrame(tick);
      });
      function tick() {
        if (!running) return;
        x.clearRect(0, 0, W, H);
        for (var i = 0; i < ps.length; i++) {
          var p = ps[i];
          p.y -= p.v;
          p.ph += 0.008;
          p.x += Math.sin(p.ph) * p.sway * 0.4;
          if (p.y < -12) ps[i] = p = spawn(false);
          x.globalAlpha = p.a;
          x.fillStyle = '#ffb24d';
          x.beginPath();
          x.arc(p.x, p.y, p.r, 0, 6.29);
          x.fill();
        }
        x.globalAlpha = 1;
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    });
  </script>
</Base>
