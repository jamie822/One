---
import Mark from './Mark.astro';
import { client } from '../data/client.js';
interface Props { current?: string; }
const { current = '' } = Astro.props;
const links = [
  ['/services/', 'Services'],
  ['/about/', 'About'],
  ['/blog/', 'Blog'],
];
const tel = client.phone.replace(/\s/g, '');
---
<header class="nav">
  <div class="wrap nav__row">
    <a class="nav__brand" href="/" aria-label={`${client.name}, home`}>
      <Mark size={30} />
      <span class="name">{client.name}</span>
    </a>
    <nav aria-label="Site">
      <ul class="nav__links">
        {links.map(([href, label]) => (
          <li><a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="nav__tel" href={`tel:${tel}`}>{client.phone}</a>
    <a class="btn btn--call nav__call" href={`tel:${tel}`} aria-label="Call Eddie">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <span>Call Eddie</span>
    </a>
    <button class="nav__menu" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-btn>
      <span class="nav__menu-bars" aria-hidden="true"><i></i><i></i></span>
      <span class="nav__menu-label">Menu</span>
    </button>
  </div>

  {/* Mobile panel: the three pages plus the phone, under the bar. */}
  <nav class="nav__panel" id="site-menu" aria-label="Site, mobile" hidden data-menu-panel>
    <ul>
      {links.map(([href, label]) => (
        <li><a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a></li>
      ))}
    </ul>
    <a class="nav__panel-tel" href={`tel:${tel}`}>{client.phone}</a>
  </nav>

  <script is:inline>
    (function () {
      var btn = document.querySelector('[data-menu-btn]');
      var panel = document.querySelector('[data-menu-panel]');
      if (!btn || !panel) return;
      function setOpen(open) {
        btn.setAttribute('aria-expanded', String(open));
        if (open) { panel.hidden = false; requestAnimationFrame(function () { panel.setAttribute('data-open', ''); }); }
        else { panel.removeAttribute('data-open'); setTimeout(function () { panel.hidden = true; }, 200); }
      }
      btn.addEventListener('click', function () {
        setOpen(btn.getAttribute('aria-expanded') !== 'true');
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { setOpen(false); btn.focus(); }
      });
    })();
  </script>
</header>
