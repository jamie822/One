---
// The ES Elec mark: a simple geometric monogram, one bolt stroke cut through
// a rounded square, three amber "circuit" slots down the right edge. Drawn in
// the direction's own grammar; no icon library carries a brand mark.
interface Props { size?: number; class?: string; }
const { size = 30, class: klass = '' } = Astro.props;
---
<svg
  viewBox="0 0 34 34" width={size} height={size}
  class={`mark ${klass}`} aria-hidden="true"
>
  <rect x="1.5" y="1.5" width="31" height="31" rx="8" fill="none"
        stroke="currentColor" stroke-opacity=".38" stroke-width="2" />
  <path d="M18.5 6.5 L11 18.5 h5.4 L14 27.5 L22.5 15 h-5.6 z"
        fill="var(--amber-500, #ff9e1f)" />
  <rect data-slot="a" x="26" y="8"  width="3.4" height="3.4" rx="1" fill="var(--amber-300, #ffb24d)" />
  <rect data-slot="b" x="26" y="15" width="3.4" height="3.4" rx="1" fill="var(--amber-300, #ffb24d)" />
  <rect data-slot="c" x="26" y="22" width="3.4" height="3.4" rx="1" fill="var(--amber-300, #ffb24d)" />
</svg>
