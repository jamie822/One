---
// Hero candidate 04 — "The wall diary".
import CalendarPage from './CalendarPage.astro';
import { studio } from '../../data/studio.js';

const mailto = `mailto:${studio.contact.email}?subject=Website%20enquiry`;

// Four pages, each denser than the last. Thirty slots on a Mon to Sat working
// month. The counts are the message: 7, 14, 22, then 29 of 30.
//
// The open slot is index 4, week one, Friday. It sits inside the first six
// cells deliberately, because the phone layout shows a single working week and
// the open slot has to survive there too. One markup, two compositions.
const PAGE_1 = [1, 8, 14, 19, 22, 26, 29];
const PAGE_2 = [1, 3, 7, 8, 10, 12, 14, 16, 19, 20, 22, 25, 26, 29];
const PAGE_3 = [0, 1, 3, 5, 6, 7, 8, 10, 11, 12, 13, 14, 16, 17, 18, 19, 20, 22, 23, 25, 26, 29];

const EMPTY = 4;
const PAGE_4 = Array.from({ length: 30 }, (_, i) => i).filter((i) => i !== EMPTY);
---

<!--
THESIS: The diary IS the hero, at wall scale, and it refuses the studio-site
default of a centred headline over an abstract dark gradient. A spark reads his
own week before he reads a word of marketing.
OWN-WORLD: Charcoal ground, panel page, hairline rule, spiral binding in the
mark's own #c9ced6. Clash Display numerals, Satoshi job chips. Rounded slots at
the mark's radius. One signature gradient, spent once, on the wash.
STORY: He sees a working month fill up, sees one Friday still open, sees who
built it, and mails the one yellow button.
FIRST VIEWPORT: Binding across the full width. Wordmark strip under it. A six by
five working month filling the middle. Page edges. Headline and one yellow
action along the bottom band.
FORM: The brand's own mark, unfolded to architectural scale. Chosen directly,
not rolled: the brief pins the world, the form and the signature interaction.
-->

<section class="calhero">
  <!-- Everything inside here is decoration. No text in it is content, nothing
       in it is focusable, and it is hidden from assistive tech entirely. -->
  <div class="cal" aria-hidden="true">
    <div class="cal__bind"><span class="cal__rings"></span></div>

    <div class="cal__word">
      <!-- Sweep one. The wordmark is printed blind at first paint, so the
           composition is complete from frame zero and nothing appears out of
           nothing, then the ink layer wipes in left to right over the top. -->
      <span class="cal__word-ghost">Stacked Out</span>
      <span class="cal__word-ink">Stacked Out</span>
    </div>

    <div class="cal__stack">
      <CalendarPage n={4} booked={PAGE_4} isFinal emptyIndex={EMPTY} />
      {/* The shadow a turning page throws onto the one beneath it. It lives
          BETWEEN the two pages rather than on either of them, which is where a
          cast shadow actually is, and which keeps an opacity animation off a
          layer that is simultaneously rotating in 3D. Measured: 24 frames over
          20ms during the flicks with these inside the pages, 8 with them out. */}
      <div class="cal__cast" data-cast="3"></div>
      <CalendarPage n={3} booked={PAGE_3} />
      <div class="cal__cast" data-cast="2"></div>
      <CalendarPage n={2} booked={PAGE_2} />
      <div class="cal__cast" data-cast="1"></div>
      <CalendarPage n={1} booked={PAGE_1} />
    </div>

    <div class="cal__edges"><span></span><span></span><span></span></div>
  </div>

  <div class="calhero__copy">
    <div class="calhero__say">
      <h1 class="calhero__h">
        Websites for electricians and solar installers, built by a spark.
      </h1>
      <p class="calhero__lead">
        {studio.founder.yearsOnTools} years on the tools, {studio.founder.yearsSelfEmployed} of
        them working for myself. I build them now because the marketing lot never
        understood the trade.
      </p>
    </div>

    <div class="calhero__act">
      <a class="btn btn--action" href={mailto}>Book yours in</a>
      <p class="calhero__mail">{studio.contact.email}</p>
      <p class="calhero__note">
        The diary is illustrative. Real job types, not a record of bookings.
      </p>
    </div>
  </div>
</section>
