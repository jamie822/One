---
// Hero candidate 04 — "The wall calendar".
import CalendarPage from './CalendarPage.astro';
import { studio } from '../../data/studio.js';

const mailto = `mailto:${studio.contact.email}?subject=Website%20enquiry`;

// THESIS: it is a printed promotional wall calendar, photographed on a dark wall.
// The month is the hero typography, the studio's name sits modest in the header
// band the way a supplier's name does on a calendar it gave away, and the grid is
// hairline rules on paper. A spark reads his own month before he reads a word of
// marketing.
//
// THE STORY THE TURNS TELL: three sheets, real months, arriving at the one ahead.
// June is quiet. July is busier. August is written in solid except one Friday.
// Two turns, not four, so the hand is unhurried.
//
// Dates are real: August 2026 starts on a Saturday, so the sheet has a sparse
// lead in row and a single date in its last row, exactly as the printed month
// does. Sundays are left blank because a spark does not work them; the one open
// day is a working Friday, and it is the only square on a written up month with
// nothing in it and a ring drawn round it.
const YEAR = 2026;

// June: a quiet month. Sundays (7, 14, 21, 28) left out.
const JUNE = [1, 3, 4, 9, 11, 16, 18, 19, 24, 26, 30];

// July: filling up.
const JULY = [
  1, 2, 3, 4, 6, 7, 8, 10, 13, 14, 15, 17, 18,
  20, 21, 22, 23, 24, 27, 28, 29, 30, 31,
];

// August: every working day written in except Friday the 7th. Sundays 2, 9, 16,
// 23 and 30 stay blank.
const AUG_OPEN = 7;
const AUGUST = Array.from({ length: 31 }, (_, i) => i + 1).filter((d) => {
  const dow = new Date(Date.UTC(YEAR, 7, d)).getUTCDay();
  return dow !== 0 && d !== AUG_OPEN;
});
---

<section class="calhero">
  <!-- Everything inside here is decoration. No text in it is content, nothing in
       it is focusable, and it is hidden from assistive tech entirely. -->
  <div class="cal" aria-hidden="true">
    <div class="cal__bind"><span class="cal__rings"></span></div>

    <!-- THE HEADER BOARD. It does not turn: the sheets hang from it, which is how
         a promotional wall calendar is actually made. The studio's name lives here
         at supplier scale, modest and secondary to the month below. Both sweeps
         cross it. -->
    <div class="cal__board">
      <div class="cal__board-print">
        <span class="cal__word">Stacked Out</span>
        <span class="cal__trade">Web design for electricians and solar installers</span>
      </div>
      <!-- Sweep one: the same two lines, in white, wiped in left to right over a
           full width mask so the travelling edge sits at the same x as the edge
           crossing the month below it. -->
      <div class="cal__board-print cal__board-print--ink">
        <span class="cal__word">Stacked Out</span>
        <span class="cal__trade">Web design for electricians and solar installers</span>
      </div>
      <!-- Sweep two, first half. The signature gradient arriving IN the mark, on
           the path the mark just took, under the identical mask and timing as the
           wash on the sheet below. One edge, two objects. -->
      <div class="cal__board-print cal__board-print--grad">
        <span class="cal__word">Stacked Out</span>
      </div>
    </div>

    <div class="cal__stack">
      {/* Interleaved by depth, bottom of the pad first. Per turning sheet: the
          cast shadow it throws DOWN onto the sheet beneath (which is where a cast
          shadow actually lives, between the two sheets), then the sheet itself. */}
      <div class="cal__page" data-page="3">
        <CalendarPage n={3} year={YEAR} month={7} booked={AUGUST} openDay={AUG_OPEN} isFinal />
        {/* The settle. Not the sheet moving: the shade of two sheets lying on top
            of it lifting away, which is what actually happens and which costs one
            opacity animation on one empty element instead of holding the whole
            settled sheet inside a live 3D transform for the entire sequence. See
            the measurement in hero-calendar.css section 5. */}
        <div class="cal__press"></div>
      </div>
      <div class="cal__cast" data-cast="2"></div>
      <div class="cal__page" data-page="2">
        <CalendarPage n={2} year={YEAR} month={6} booked={JULY} />
      </div>
      <div class="cal__cast" data-cast="1"></div>
      <div class="cal__page" data-page="1">
        <CalendarPage n={1} year={YEAR} month={5} booked={JUNE} />
      </div>
    </div>

    <!-- The rest of the pad. Seven sheets, each stepped down and inset from the
         one above, so the bottom of the calendar is a block of paper with a
         measurable thickness rather than a single line. --k is the sheet's depth;
         the CSS derives its offset, inset, opacity and stacking from it. -->
    <div class="cal__edges">
      {Array.from({ length: 7 }, (_, k) => <span style={`--k:${k}`}></span>)}
    </div>
  </div>

  <div class="calhero__copy">
    <div class="calhero__say">
      <h1 class="calhero__h">
        Websites for electricians and solar installers, built by a spark.
      </h1>
      <p class="calhero__lead">
        {studio.founder.yearsOnTools} years on the tools, {studio.founder.yearsSelfEmployed} of
        them working for myself. I build them now because the marketing lot never
        understood the trade.
      </p>
    </div>

    <div class="calhero__act">
      <a class="btn btn--action" href={mailto}>Book yours in</a>
      <p class="calhero__mail">{studio.contact.email}</p>
      <p class="calhero__note">
        The calendar is illustrative. Real job types, not a record of bookings.
      </p>
    </div>
  </div>
</section>
