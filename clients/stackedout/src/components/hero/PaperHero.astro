---
// PAPER HERO — the photographic wall calendar.
//
// This replaces the CSS calendar as the hero. Not because the CSS one was wrong,
// but because of what it could never do: a flat plane has one surface normal, so
// it catches light evenly and paper stops reading as paper. Four attempts at a
// corner peel in CSS proved that, and the fifth only worked by shading a canvas
// mesh by hand. Film of real paper has the light for free.
//
// The turn is a 5 second clip generated through the Higgsfield MCP from an
// approved still, which is their own grounded pipeline: check the composition as
// a frame first, then animate that exact frame, so the motion cannot wander off
// into a different photograph. Brief was explicit about the things that were
// wrong before — bottom right corner first, slow, no hands, no camera move, and
// no text on the paper at any point.
//
// NO TEXT ON THE PAPER IS DELIBERATE, TWICE OVER. Generated video cannot spell,
// so asking for dates would have produced garbled glyphs. It also means the only
// type in the hero is real DOM type, which is selectable, translatable, and
// crisp at any density. The printed grid is empty on purpose and the wordmark
// sits on it.
//
// THE WORDMARK. Two stacked copies of the same word. The first inks in from left
// to right in white. The second is the brand gradient, revealed by the same left
// to right sweep a beat later, so the colour arrives across the word in the same
// direction the word did. That is the signature gradient for this page and there
// is no second one.
//
// The h1 is NOT in here. It sits outside the stage as normal document text,
// because it is the LCP element and the rule is that the LCP element is never
// animated.
//
// WITHOUT JAVASCRIPT, OR UNDER REDUCED MOTION, the poster frame is the hero and
// the film never starts. The poster is the approved still, so the fallback is
// the composition that was signed off rather than a blank box.
import { studio } from '../../data/studio.js';
---
<div class="ph" data-paper-hero>
  <div class="ph__stage">
    {/* aria-hidden: it is a photograph of paper carrying no information the copy
        below does not already state, and a screen reader announcing a video
        element here would only get in the way. */}
    <video
      class="ph__film"
      poster="/img/hero-calendar.webp"
      width="1344" height="576"
      muted playsinline preload="auto"
      aria-hidden="true" tabindex="-1"
    >
      <source src="/video/hero-turn.mp4" type="video/mp4" />
    </video>

    <p class="ph__word" aria-label={studio.name}>
      {/* Two copies, one accessible name. The ink layer is what a reader sees
          first; the gradient layer arrives over it. */}
      <span class="ph__ink" aria-hidden="true">Stacked&nbsp;Out</span>
      <span class="ph__grad" aria-hidden="true">Stacked&nbsp;Out</span>
    </p>

    <p class="ph__strap">Web design for electricians and solar installers</p>

    {/* The way in when the film cannot start on its own. Muted autoplay is allowed
        by every browser's policy, but it is NOT allowed inside a cross origin
        iframe that was not granted allow="autoplay" — which is how a preview gets
        embedded — and data saver and battery saver both block it outright. In all
        of those the poster is a still calendar and the visitor has no way to know
        anything was meant to happen. So the control is real: hidden while the film
        is playing or has finished, visible the moment we know it will not start by
        itself, and a click is the gesture that satisfies the policy. */}
    <button class="ph__play" type="button" hidden data-play>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="currentColor">
        <path d="M8 5v14l11-7z" />
      </svg>
      Play the turn
    </button>
  </div>
</div>

<script is:inline>
  // Small enough to stay inline: it decides whether the film runs at all, and
  // that decision has to be made before the first frame either way.
  (function () {
    var host = document.querySelector('[data-paper-hero]');
    if (!host) return;
    var film = host.querySelector('.ph__film');
    if (!film) return;

    var button = host.querySelector('[data-play]');
    var still = window.matchMedia('(prefers-reduced-motion: reduce)');
    var started = false;

    // ph--live is added on the PLAYING event, not before the attempt. The wordmark
    // timeline is keyed to the film's own clock — ink at 2.5s, colour at 3.15s —
    // so running it while the film sits on its poster would sweep the word over a
    // still and land the colour on nothing. If the film never starts, the page
    // falls back to exactly the no-JavaScript state: poster, and the word simply
    // there, fully inked.
    film.addEventListener('playing', function () {
      started = true;
      host.classList.add('ph--live');
      if (button) button.hidden = true;
    });

    function offer() {
      if (started || !button) return;
      button.hidden = false;
    }

    function play() {
      var p = film.play();
      if (p && p.catch) {
        // A rejected play() is the browser saying no, not an error. Blocked
        // autoplay, an iframe without allow="autoplay", data saver, low power
        // mode: all land here, and all of them are recoverable with one click.
        p.catch(offer);
      }
    }

    function arm() {
      if (still.matches) { offer(); return; }
      // Wait until it can run start to finish. Starting the turn and stalling
      // halfway through is worse than starting it a beat late.
      if (film.readyState >= 3) play();
      else film.addEventListener('canplaythrough', play, { once: true });
      // And if the file never gets that far — no decoder for this codec, a failed
      // request, a stalled network — say so with the control rather than sitting
      // on a poster that pretends nothing was missing.
      setTimeout(offer, 2500);
    }
    film.addEventListener('error', offer);

    if (button) {
      button.addEventListener('click', function () {
        // A real gesture, so this attempt is allowed even where autoplay was not.
        // Rewind first: a blocked attempt can still have advanced the clock.
        try { film.currentTime = 0; } catch (e) {}
        film.play();
      });
    }

    // Only when it is on screen. A hero is on screen at load, but this also
    // covers a reload part way down the page, where autoplaying a turn nobody
    // can see wastes the one time it happens.
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { io.disconnect(); arm(); }
        });
      }, { threshold: 0.25 });
      io.observe(host);
    } else {
      arm();
    }

    // Someone turning reduced motion on mid session should not be mid turn.
    still.addEventListener('change', function () {
      if (still.matches) { film.pause(); host.classList.remove('ph--live'); }
    });
  })();
</script>
