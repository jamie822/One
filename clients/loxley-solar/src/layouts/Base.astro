---
// Base layout: head, schema, nav, sticky bar, footer. Every page uses it.
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { client } from '../data/client.js';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/site.css';

interface Props {
  title: string;
  description: string;
  current?: string;
  /** extra JSON-LD blocks, already-built objects */
  schema?: object[];
  /** preload the hero image on pages that have one */
  preloadImage?: string;
  preloadSrcset?: string;
  preloadSizes?: string;
}
const { title, description, current = '', schema = [], preloadImage, preloadSrcset, preloadSizes } = Astro.props;
const tel = client.phone.replace(/\s/g, '');
const quoteHref = ['/', '/services/'].includes(current) ? '#quote' : '/#quote';

// The business, stated once, on every page. HomeAndConstructionBusiness is
// the most specific valid schema.org type for a solar installer.
// aggregateRating is TEMP demo data: it swaps or goes at go-live.
const business = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': 'https://loxleysolar.co.uk/#business',
  name: client.name,
  legalName: client.legalName,
  description: 'MCS-certified solar panel, battery storage and EV charger installer in Sheffield.',
  telephone: client.phone,
  email: client.email,
  url: 'https://loxleysolar.co.uk/',
  priceRange: '£££',
  address: {
    '@type': 'PostalAddress',
    streetAddress: client.address.street,
    addressLocality: client.address.locality,
    addressRegion: client.address.region,
    postalCode: client.address.postcode,
    addressCountry: 'GB',
  },
  geo: { '@type': 'GeoCoordinates', latitude: client.geo.lat, longitude: client.geo.lng },
  areaServed: client.areas.map((a) => ({ '@type': 'Place', name: a })),
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00', closes: '18:00',
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: client.google.rating,
    reviewCount: client.google.reviewCount,
  },
};
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, 'https://loxleysolar.co.uk')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#fbfaf7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/sora-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/sora-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    {preloadImage && (
      <link
        rel="preload"
        as="image"
        href={preloadSrcset ? undefined : preloadImage}
        imagesrcset={preloadSrcset}
        imagesizes={preloadSizes}
        fetchpriority="high"
      />
    )}
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {/* Mobile: the form leads here too; phone one tap away. */}
    <nav class="bar" data-bar aria-label="Quick contact">
      <a class="bar__quote" href={quoteHref}>Get a quote</a>
      <a class="bar__call" href={`tel:${tel}`}>Call Dan</a>
    </nav>
    <script is:inline>
      // Observers, no scroll listeners. html.js arms the hidden reveal state,
      // so a browser without JS just sees the page.
      (function () {
        if (!('IntersectionObserver' in window)) return;
        document.documentElement.classList.add('js');

        // Landing on an anchor: show that section instantly.
        if (location.hash) {
          var target = document.querySelector(location.hash);
          if (target) target.querySelectorAll('.rise').forEach(function (el) { el.classList.add('is-in'); });
          if (target && target.classList.contains('rise')) target.classList.add('is-in');
        }

        // Reveals: fire once on first entry.
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('.rise').forEach(function (el) { io.observe(el); });

        // Count-ups: figures roll to their value the first time they appear.
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var cio = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting) return;
            cio.unobserve(e.target);
            var el = e.target;
            var end = parseFloat(el.dataset.count);
            var dp = (el.dataset.count.split('.')[1] || '').length;
            if (reduce) { el.textContent = el.dataset.count; return; }
            var t0 = null;
            function step(t) {
              if (!t0) t0 = t;
              var p = Math.min((t - t0) / 900, 1);
              var eased = 1 - Math.pow(1 - p, 3);
              el.textContent = (end * eased).toFixed(dp);
              if (p < 1) requestAnimationFrame(step);
            }
            requestAnimationFrame(step);
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('[data-count]').forEach(function (el) { cio.observe(el); });

        // The bar waits for intent: one viewport of scroll.
        var bar = document.querySelector('[data-bar]');
        if (!bar) return;
        var s = document.createElement('div');
        s.style.cssText = 'position:absolute;top:520px;height:1px;width:1px;pointer-events:none;';
        document.body.prepend(s);
        new IntersectionObserver(function (e) {
          if (e[0].boundingClientRect.top < 0) bar.setAttribute('data-on', '');
          else bar.removeAttribute('data-on');
        }).observe(s);
      })();
    </script>
  </body>
</html>
