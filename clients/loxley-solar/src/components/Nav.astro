---
import Mark from './Mark.astro';
import { client } from '../data/client.js';
interface Props { current?: string; }
const { current = '' } = Astro.props;
const links = [
  ['/services/', 'Services'],
  ['/about/', 'About'],
  ['/blog/', 'Blog'],
];
const tel = client.phone.replace(/\s/g, '');
const quoteHref = ['/', '/services/'].includes(current) ? '#quote' : '/#quote';
---
<header class="nav">
  <div class="wrap nav__row">
    <a class="nav__brand" href="/" aria-label={`${client.name}, home`}>
      <Mark size={30} />
      <span>{client.name}</span>
    </a>
    <nav aria-label="Site">
      <ul class="nav__links">
        {links.map(([href, label]) => (
          <li><a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
    <a class="nav__tel" href={`tel:${tel}`}>{client.phone}</a>
    <a class="btn btn--quote" href={quoteHref}>Get a quote</a>
    <button class="nav__menu" type="button" aria-expanded="false" aria-controls="site-menu" data-menu-btn>
      <span class="nav__menu-bars" aria-hidden="true"><i></i><i></i></span>
      <span>Menu</span>
    </button>
  </div>

  <nav class="nav__panel" id="site-menu" aria-label="Site, mobile" hidden data-menu-panel>
    <ul>
      {links.map(([href, label]) => (
        <li><a href={href} aria-current={current === href ? 'page' : undefined}>{label}</a></li>
      ))}
    </ul>
    <div class="nav__panel-acts">
      <a class="nav__panel-tel" href={`tel:${tel}`}>{client.phone}</a>
      <a class="nav__panel-quote" href={quoteHref}>Get a quote</a>
    </div>
  </nav>

  <script is:inline>
    (function () {
      var btn = document.querySelector('[data-menu-btn]');
      var panel = document.querySelector('[data-menu-panel]');
      if (!btn || !panel) return;
      function setOpen(open) {
        btn.setAttribute('aria-expanded', String(open));
        if (open) { panel.hidden = false; requestAnimationFrame(function () { panel.setAttribute('data-open', ''); }); }
        else { panel.removeAttribute('data-open'); setTimeout(function () { panel.hidden = true; }, 200); }
      }
      btn.addEventListener('click', function () {
        setOpen(btn.getAttribute('aria-expanded') !== 'true');
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') { setOpen(false); btn.focus(); }
      });
    })();
  </script>
</header>
