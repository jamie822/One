---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import Placeholder from '../components/Placeholder.astro';
import CtaBand from '../components/CtaBand.astro';
import { site, services, process, testimonials, faqs } from '../data/site.js';

const featured = services.slice(0, 6);
const reasons = [
  { t: 'Qualified & accredited', d: `${site.accreditations.join(', ')} — work to the latest 18th Edition regulations.` },
  { t: 'Upfront, fair pricing', d: 'Clear, fixed quotes with no hidden extras and no call-out surprises.' },
  { t: 'Clean & respectful', d: 'We treat your home or premises with care and leave every job spotless.' },
  { t: 'Local & reliable', d: `Based near ${site.address.locality} — we turn up when we say we will.` },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Layout
  path="/"
  description={`${site.name} — experienced ${site.accreditations[0]} electricians in ${site.address.locality}. Domestic & commercial: rewires, fuse boards, EV chargers, EICR testing. Free quotes — call ${site.phone}.`}
>
  <!-- HERO -->
  <Hero>
    <div class="rating">
      <span class="rating__g">Google</span>
      <span class="rating__stars"><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /></span>
      <span class="rating__count">{site.googleRating} · {site.reviewCount} reviews</span>
    </div>
    <span class="eyebrow" style="color:var(--brand)">Electrician in {site.address.locality}</span>
    <h1><span class="line-brand">Domestic &amp; Commercial</span> Electrical Services</h1>
    <p>{site.brandStatement} {site.address.locality}-based, {site.accreditations[0]} electricians carrying out rewires, fuse boards, EV chargers and safety testing — with clear pricing, no call-out fees and guaranteed workmanship.</p>
    <div class="hero__actions">
      <a class="btn btn--brand btn--lg" href="/contact">Get a Quote <Icon name="arrow" /></a>
      <a class="hero__phone" href={`tel:${site.phoneHref}`}><Icon name="phone" /> {site.phone}</a>
    </div>
  </Hero>

  <!-- TRUST ROW -->
  <div class="trustrow">
    <div class="container trustrow__inner">
      {site.accreditations.map((a) => (
        <span class="trustchip"><Icon name="shield" /> {a}</span>
      ))}
      <span class="trustchip"><Icon name="check" /> 18th Edition Certified</span>
      <span class="trustchip"><Icon name="clock" /> Same-Day Response</span>
    </div>
  </div>

  <!-- SERVICES -->
  <section class="section section--soft">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">Professional Services</span>
        <h2>Our Electrical Services</h2>
        <p>Whether you're a <span class="hl">domestic</span> or <span class="hl">commercial</span> customer, need a small job or a major install, we have a service to suit your needs — all fully certified.</p>
      </div>
      <div class="grid grid--3">
        {featured.map((s, i) => (
          <article class="svc reveal" data-delay={String(i % 3)}>
            <div class="svc__icon"><Icon name={s.icon} /></div>
            <h3>{s.title}</h3>
            <p>{s.short}</p>
            <a class="svc__more" href={`/services#${s.slug}`}>Learn More <Icon name="arrow" /></a>
          </article>
        ))}
      </div>
      <div class="text-center" style="margin-top:42px">
        <a class="btn btn--dark btn--lg" href="/services">View All Services <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="section">
    <div class="container split">
      <div class="split__media media-frame reveal">
        <Placeholder src={site.vanImage} alt={`${site.name} electrician at work`} label="Photo of the team / van / a finished job" hint="Drop a real image into /public/images and set vanImage in src/data/site.js" variant="ph--wide" />
      </div>
      <div class="reveal" data-delay="1">
        <span class="eyebrow">Why Choose Us</span>
        <h2>Local electricians you can trust</h2>
        <p class="lead">We treat every job — big or small — with the same care, leaving you with safe, reliable electrics and zero mess.</p>
        <ul class="checklist">
          {reasons.map((r) => (
            <li><span class="tick"><Icon name="check" /></span><span><strong>{r.t}.</strong> {r.d}</span></li>
          ))}
        </ul>
        <div style="margin-top:26px"><a class="btn btn--brand" href="/about">More About Us <Icon name="arrow" /></a></div>
      </div>
    </div>
  </section>

  <!-- BOOKING STEPS (dark) -->
  <section class="section section--dark">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">How It Works</span>
        <h2>How to book an electrician with us</h2>
        <p>Getting expert electrical work done shouldn't be complicated. Here's how we keep it simple.</p>
      </div>
      <div class="steps">
        {process.map((p, i) => (
          <div class="step reveal" data-delay={String(i % 4)}>
            <div class="step__n">{p.n}</div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- REVIEWS (pink band) -->
  <section class="section reviews">
    <div class="container">
      <div class="reviews__head reveal">
        <div class="rating" style="justify-content:center">
          <span class="rating__g" style="color:#fff">{site.googleRating} / 5</span>
          <span class="rating__stars"><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /></span>
        </div>
        <h2>Real stories, real reviews from happy customers</h2>
      </div>
      <div class="grid grid--3">
        {testimonials.map((t, i) => (
          <figure class="quote reveal" data-delay={String(i % 3)} style="margin:0">
            <div class="quote__stars"><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /><Icon name="star" /></div>
            <blockquote style="margin:0"><p>{t.quote}</p></blockquote>
            <figcaption class="quote__author"><strong>{t.author}</strong>{t.location}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section class="section">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">Our Work</span>
        <h2>Our electrical work in action across {site.address.locality}</h2>
        <p>A few examples of completed jobs — swap these for real photos from Instagram.</p>
      </div>
      <div class="tiles">
        {Array.from({ length: 6 }).map((_, i) => (
          <div class="media-frame reveal" data-delay={String(i % 3)}><Placeholder label={`Job photo ${i + 1}`} variant="ph--square" /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--soft">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">Good To Know</span>
        <h2>Frequently asked questions</h2>
      </div>
      <div class="faq reveal">
        {faqs.map((f) => (
          <details>
            <summary>{f.q} <span class="plus"></span></summary>
            <div class="faq__body"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- OWNER + VAN BAND -->
  <section class="vanband">
    <div class={`vanband__bg${site.vanImage ? '' : ' is-placeholder'}`}>
      {site.vanImage && <img src={site.vanImage} alt={`${site.name} branded van`} />}
    </div>
    <div class="vanband__inner reveal">
      <span class="eyebrow" style="color:var(--brand)">Your Local Electricians</span>
      <h2>Ready when you are</h2>
      <p>Friendly, fully-qualified and insured. Get a free, no-obligation quote for electrical work across {site.address.locality} and nearby.</p>
      <div class="cta-band__actions" style="margin-top:8px">
        <a class="btn btn--brand btn--lg" href={`tel:${site.phoneHref}`}><Icon name="phone" /> Call {site.phone}</a>
        <a class="btn btn--outline-light btn--lg" href="/contact">Request a Quote</a>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
