---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Placeholder from '../components/Placeholder.astro';
import CtaBand from '../components/CtaBand.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import { href } from '../lib/href.js';
import { site, pains, services, packages, faqs } from '../data/site.js';
const { stats } = site;

// Animated hero: rising gold "sparks" + a rotating headline word.
const sparks = Array.from({ length: 18 }, (_, i) => ({
  left: (i * 5.5 + (i % 3) * 4) % 100,
  dur: 6 + ((i * 1.7) % 7),
  delay: (i * 0.9) % 9,
  size: 2 + ((i * 1.3) % 3),
}));
const rotateWords = [
  'work even harder.',
  'quote at 9pm.',
  'chase invoices.',
  'miss bath time.',
  'be the business.',
];

const featured = services.slice(0, 6);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Layout path="/">
  <!-- ANIMATED HERO -->
  <section class="hero hero--home">
    <div class="hero__bg is-placeholder"></div>
    <div class="hero__glow"></div>
    <canvas class="hero__lightning" data-lightning aria-hidden="true"></canvas>
    <div class="hero__flash" data-flash aria-hidden="true"></div>
    <div class="sparks" aria-hidden="true">
      {sparks.map((s) => (
        <span class="spark" style={`left:${s.left}%;width:${s.size}px;height:${s.size}px;animation-duration:${s.dur}s;animation-delay:${s.delay}s`}></span>
      ))}
    </div>
    <div class="container">
      <div class="hero__inner">
        <span class="eyebrow">Websites &amp; online presence for electricians</span>
        <h1>You didn't go self-employed to <span class="rotator" data-rotator data-words={JSON.stringify(rotateWords)}><span class="rotator__word serif gold">{rotateWords[0]}</span></span></h1>
        <p class="hero__lead">We <strong>rewire your business</strong> — the website, lead generation &amp; systems that win you better work and get you off the tools.</p>
        <div class="hero__chips">
          <span>Websites</span><span>Branding</span><span>Lead Generation</span><span>Automation</span><span>Reviews</span>
        </div>
        <div class="hero__actions">
          <a class="btn btn--gold btn--lg" href={href('/contact')}>Book a Call <Icon name="arrow" /></a>
          <a class="btn btn--ghost btn--lg" href={href('/packages')}>See Packages</a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const flash = document.querySelector('[data-flash]');

    // --- Lightning strike (exposed so the headline can trigger it) ----------
    let strike = () => {};
    const canvas = document.querySelector('[data-lightning]');
    if (canvas && !reduce) {
      const ctx = canvas.getContext('2d');
      const hero = canvas.closest('.hero');
      let W = 0, H = 0, dpr = Math.min(window.devicePixelRatio || 1, 2);
      const resize = () => {
        W = hero.clientWidth; H = hero.clientHeight;
        canvas.width = W * dpr; canvas.height = H * dpr;
        canvas.style.width = W + 'px'; canvas.style.height = H + 'px';
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };
      resize();
      window.addEventListener('resize', resize, { passive: true });

      function build(x1, y1, x2, y2, disp, out) {
        if (disp < 7) { out.push([x1, y1, x2, y2]); return; }
        const mx = (x1 + x2) / 2 + (Math.random() - 0.5) * disp;
        const my = (y1 + y2) / 2 + (Math.random() - 0.5) * disp * 0.4;
        build(x1, y1, mx, my, disp / 2, out);
        build(mx, my, x2, y2, disp / 2, out);
        if (Math.random() < 0.34) {
          const bx = mx + (Math.random() - 0.5) * disp * 1.4;
          const by = my + disp * (0.5 + Math.random());
          build(mx, my, bx, by, disp / 2.2, out);
        }
      }
      function drawSegs(segs, alpha, lw, color) {
        ctx.strokeStyle = color; ctx.lineWidth = lw; ctx.globalAlpha = alpha;
        ctx.shadowColor = '#e4c77b'; ctx.shadowBlur = 18; ctx.lineCap = 'round';
        ctx.beginPath();
        for (const s of segs) { ctx.moveTo(s[0], s[1]); ctx.lineTo(s[2], s[3]); }
        ctx.stroke();
      }
      let busy = false;
      strike = function () {
        if (busy) return; busy = true;
        const startX = W * (0.42 + Math.random() * 0.5);
        const endX = startX + (Math.random() - 0.5) * W * 0.3;
        const segs = [];
        build(startX, -10, endX, H * (0.7 + Math.random() * 0.3), W * 0.16, segs);
        // thunder flash
        if (flash) { flash.classList.add('is-on'); setTimeout(() => flash.classList.remove('is-on'), 90); }
        const frames = [1, 0.4, 0.95, 0.5, 0.8, 0.3, 0];
        let f = 0;
        const flicker = () => {
          ctx.clearRect(0, 0, W, H);
          const a = frames[f];
          if (a > 0) {
            drawSegs(segs, a, 3.4, '#e4c77b');
            drawSegs(segs, a * 0.95, 1.5, '#fff7e6');
            ctx.globalAlpha = 1; ctx.shadowBlur = 0;
          }
          f++;
          if (f < frames.length) setTimeout(flicker, 42);
          else { ctx.clearRect(0, 0, W, H); busy = false; }
        };
        flicker();
      };
    }

    // --- Rotating headline (drives the lightning) ---------------------------
    const r = document.querySelector('[data-rotator]');
    if (r && !reduce) {
      const words = JSON.parse(r.getAttribute('data-words') || '[]');
      const el = r.querySelector('.rotator__word');
      let i = 0;
      setInterval(() => {
        strike();                       // bolt fires as the pain word changes
        r.classList.add('is-swapping');
        setTimeout(() => {
          i = (i + 1) % words.length;
          el.textContent = words[i];
          r.classList.remove('is-swapping');
        }, 420);
      }, 2800);
      setTimeout(strike, 900);          // opening strike
    }
  </script>

  <!-- PAIN POINTS -->
  <section class="section">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow" style="justify-content:center">Sound familiar?</span>
        <hr class="rule" />
        <h2>You're a brilliant electrician.<br />The <span class="gold">business</span> is the problem.</h2>
        <p>You started this for freedom and more money. If any of this hits home, you're exactly who we built Off The Tools for.</p>
      </div>
      <div class="grid grid--3">
        {pains.map((p, i) => (
          <article class="pain reveal" data-delay={String(i % 3)}>
            <span class="pain__n">0{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SOLUTION / SERVICES -->
  <section class="section section--panel">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow" style="justify-content:center">The fix</span>
        <hr class="rule" />
        <h2>Everything you need to look premium &amp; get booked</h2>
        <p>One partner for your entire online presence — built by an electrician who's lived every one of those pain points.</p>
      </div>
      <div class="grid grid--3">
        {featured.map((s, i) => (
          <article class="svc reveal" data-delay={String(i % 3)}>
            <div class="svc__icon"><Icon name={s.icon} /></div>
            <h3>{s.title}</h3>
            <p>{s.short}</p>
            <a class="svc__more" href={href('/services#' + s.slug)}>Learn more <Icon name="arrow" /></a>
          </article>
        ))}
      </div>
      <div class="text-center" style="margin-top:46px">
        <a class="btn btn--ghost btn--lg" href={href('/services')}>Explore What We Do <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- STORY TEASER -->
  <section class="section">
    <div class="container split">
      <div class="split__media media-frame reveal">
        <Placeholder src={site.storyImage} alt={`${site.founder.name}, founder of ${site.name}`} label="Your photo / portrait" hint="Drop a graded image into /public/images and set storyImage in src/data/site.js" variant="ph--portrait" />
      </div>
      <div class="reveal" data-delay="1">
        <span class="eyebrow">Built by one of your own</span>
        <hr class="rule" />
        <h2>I'm not a marketer in a suit.<br />I'm an <span class="gold">electrician</span>.</h2>
        <p class="lead">{site.founder.background}. I felt every pain point on this page first-hand — the late-night quotes, the embarrassing website, the feast-or-famine months.</p>
        <p style="color:var(--muted)">So I learned the websites, the marketing and the systems the hard way, watched my business transform, and built Off The Tools to give other sparks the same unfair advantage — without the years of trial and error.</p>
        <div style="margin-top:26px"><a class="btn btn--gold" href={href('/story')}>Read My Story <Icon name="arrow" /></a></div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="section--tight">
    <div class="container">
      <div class="stats">
        {stats.map((s, i) => (
          <div class="stat reveal" data-delay={String(i % 4)}>
            <div class="stat__num gold">{s.num}</div>
            <div class="stat__label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PACKAGES PREVIEW -->
  <section class="section section--panel">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow" style="justify-content:center">Choose your level</span>
        <hr class="rule" />
        <h2>Packages built around where you are</h2>
        <p>From looking the part to building a business that runs without you. No off-the-shelf pricing — just the right fit for your stage.</p>
      </div>
      <div class="pkgs">
        {packages.map((pkg) => (
          <article class={`pkg reveal${pkg.best ? ' pkg--best' : ''}`}>
            {pkg.best && <span class="pkg__badge">Most popular</span>}
            <div class="pkg__name">{pkg.name}</div>
            <div class="pkg__tag">{pkg.tagline}</div>
            <p class="pkg__summary">{pkg.summary}</p>
            <ul class="pkg__features">
              {pkg.features.map((f) => (<li><Icon name="check" /> {f}</li>))}
            </ul>
            <a class={`btn ${pkg.best ? 'btn--gold' : 'btn--ghost'}`} href={href('/contact')}>{pkg.cta} <Icon name="arrow" /></a>
          </article>
        ))}
      </div>
      <p class="text-center" style="margin-top:34px;color:var(--muted)">Not sure which fits? <a href={href('/packages')}>Compare packages</a> or just book a call.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow" style="justify-content:center">Good to know</span>
        <hr class="rule" />
        <h2>Questions, answered</h2>
      </div>
      <div class="faq reveal">
        {faqs.map((f) => (
          <details>
            <summary>{f.q} <span class="plus"></span></summary>
            <div class="faq__body"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <LeadMagnet />

  <CtaBand />

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>
