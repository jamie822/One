---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { href } from '../lib/href.js';
import { site, services } from '../data/site.js';

const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem', position: i + 1,
    item: { '@type': 'Service', name: s.title, description: s.short, provider: { '@type': 'ProfessionalService', name: site.name } },
  })),
};
---
<Layout path="/services" title="What We Do" description={`${site.name} builds premium websites, branding, lead generation, automation and coaching for electricians who want to get off the tools.`}>
  <Hero inner={true}>
    <span class="eyebrow">What We Do</span>
    <h1>Your whole online presence, <span class="serif gold">done for you</span>.</h1>
    <p>From the website that wins the work to the systems that capture it — everything an electrical business needs to look premium and grow, built by someone who's done it.</p>
    <div class="hero__actions">
      <a class="btn btn--gold btn--lg" href={href('/contact')}>Book a Call <Icon name="arrow" /></a>
      <a class="btn btn--ghost btn--lg" href={href('/packages')}>See Packages</a>
    </div>
  </Hero>

  <section class="section">
    <div class="container">
      <div class="grid grid--2">
        {services.map((s, i) => (
          <article class="svc reveal" data-delay={String(i % 2)} id={s.slug}>
            <div class="svc__icon"><Icon name={s.icon} /></div>
            <h3>{s.title}</h3>
            <p>{s.long}</p>
            <a class="svc__more" href={href('/contact')}>Get this <Icon name="arrow" /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--panel">
    <div class="container container--narrow text-center reveal">
      <span class="eyebrow" style="justify-content:center">One partner, not five</span>
      <hr class="rule" />
      <h2>Stop stitching together freelancers</h2>
      <p class="lead" style="margin-top:18px">A web guy here, a "social media person" there, a lead-gen company that doesn't get the trade. We bring it all under one roof — joined up, on brand, and accountable to one thing: more of the right jobs for you.</p>
    </div>
  </section>

  <CtaBand />
  <script type="application/ld+json" set:html={JSON.stringify(servicesSchema)} />
</Layout>
