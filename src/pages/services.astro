---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { href } from '../lib/href.js';
import { site, services, process } from '../data/site.js';

const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: { '@type': 'Service', name: s.title, description: s.short, areaServed: site.address.locality, provider: { '@type': 'Electrician', name: site.name } },
  })),
};
---
<Layout
  path="/services"
  title="Electrical Services"
  description={`Full list of electrical services from ${site.name} in ${site.address.locality}: rewires, fuse board upgrades, EV chargers, EICR testing, lighting, fault finding and commercial work.`}
>
  <Hero inner={true}>
    <span class="eyebrow" style="color:var(--brand)">Our Services</span>
    <h1>Electrical services in {site.address.locality}</h1>
    <p>Whatever you need — at home or in business — we've got it covered. Every job is carried out by experienced electricians, fully certified and guaranteed.</p>
    <div class="hero__actions">
      <a class="btn btn--brand btn--lg" href={href('/contact')}>Get a Quote <Icon name="arrow" /></a>
      <a class="hero__phone" href={`tel:${site.phoneHref}`}><Icon name="phone" /> {site.phone}</a>
    </div>
  </Hero>

  <section class="section">
    <div class="container">
      <div class="grid grid--2">
        {services.map((s, i) => (
          <article class="svc reveal" data-delay={String(i % 2)} id={s.slug}>
            <div class="svc__icon"><Icon name={s.icon} /></div>
            <h3>{s.title}</h3>
            <p>{s.long}</p>
            <a class="svc__more" href={href(`/contact?service=${encodeURIComponent(s.title)}`)}>Get a Quote <Icon name="arrow" /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">How It Works</span>
        <h2>From first call to certified finish</h2>
        <p>A straightforward process designed to make your life easier.</p>
      </div>
      <div class="steps">
        {process.map((p, i) => (
          <div class="step reveal" data-delay={String(i % 4)}>
            <div class="step__n">{p.n}</div>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />

  <script type="application/ld+json" set:html={JSON.stringify(servicesSchema)} />
</Layout>
