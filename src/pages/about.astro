---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Placeholder from '../components/Placeholder.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site.js';

const values = [
  { t: 'Honesty first', d: 'Straight answers, fair prices and no upselling work you don’t need.', icon: 'shield' },
  { t: 'Quality workmanship', d: 'Neat, safe installations that are built to last and fully certified.', icon: 'check' },
  { t: 'Customer care', d: 'Friendly, punctual and respectful of your home or workplace.', icon: 'star' },
];
---
<Layout
  path="/about"
  title="About Us"
  description={`Meet the team behind ${site.name} — experienced, ${site.accreditations[0]} electricians serving ${site.address.locality}. Your source for all things electrical.`}
>
  <section class="hero">
    <div class="container">
      <div class="hero__inner">
        <span class="eyebrow">About us</span>
        <h1>Your local electrician in {site.address.locality}</h1>
        <p>{site.name} is built on a simple idea: do great electrical work, treat people fairly, and turn up when you say you will.</p>
      </div>
    </div>
  </section>

  <!-- OWNER -->
  <section class="section">
    <div class="container split">
      <div class="split__media media-frame media-frame--float reveal">
        <Placeholder
          src={site.owner.photo}
          alt={`${site.owner.name}, ${site.owner.role} at ${site.name}`}
          label="Photo of the owner"
          hint="From Instagram — save it to /public/images/ and set owner.photo in src/data/site.js"
          variant="ph--portrait"
        />
      </div>
      <div class="reveal" data-delay="1">
        <span class="eyebrow">Meet the team</span>
        <h2>Experienced electricians who care</h2>
        <p class="lead">{site.brandStatement}</p>
        <p>
          With {site.yearsExperience} years in the trade, {site.name} offers {site.address.locality} a more
          dependable kind of electrician — combining proper qualifications and high standards with
          genuinely friendly, no-nonsense service.
        </p>
        <p>
          {/* TODO: replace with the owner's real story / name from his Instagram or your notes. */}
          Every job, from a single socket to a full rewire, gets the same attention to detail and the
          same commitment to leaving customers completely happy with the result — which is exactly why
          so many of our customers come back and recommend us.
        </p>
        <div class="hero__badges" style="margin-top:20px">
          {site.accreditations.map((a) => (
            <span class="badge" style="background:rgba(10,31,60,.05);border-color:var(--line);color:var(--navy)">
              <Icon name="shield" /> {a}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="section section--soft">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">What we stand for</span>
        <h2>How we work</h2>
      </div>
      <div class="grid grid--3">
        {values.map((v, i) => (
          <article class="card reveal" data-delay={String(i % 3)}>
            <div class="card__icon"><Icon name={v.icon} /></div>
            <h3>{v.t}</h3>
            <p>{v.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- WORK GALLERY -->
  <section class="section">
    <div class="container">
      <div class="section__head reveal">
        <span class="eyebrow">Recent work</span>
        <h2>A look at our jobs</h2>
        <p>A few examples of completed work — swap these for real photos from Instagram.</p>
      </div>
      <div class="tiles">
        {Array.from({ length: 6 }).map((_, i) => (
          <div class="media-frame reveal" data-delay={String(i % 3)}>
            <Placeholder label={`Job photo ${i + 1}`} variant="ph--square" />
          </div>
        ))}
      </div>
      <div class="text-center" style="margin-top:36px">
        <a class="btn btn--dark" href={site.instagram} target="_blank" rel="noopener"><Icon name="instagram" /> See more on Instagram</a>
      </div>
    </div>
  </section>

  <CtaBand title={`Work with ${site.name}`} />
</Layout>
