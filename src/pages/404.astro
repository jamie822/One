---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import { href } from '../lib/href.js';
import { site } from '../data/site.js';
---
<Layout path="/404" title="Page not found">
  <Hero inner={true}>
    <span class="eyebrow">404</span>
    <h1>This page is <span class="serif gold">off the grid</span>.</h1>
    <p>The page you're after has moved or never existed. Let's get you back on track.</p>
    <div class="hero__actions">
      <a class="btn btn--gold btn--lg" href={href('/')}>Back to Home</a>
      <a class="btn btn--ghost btn--lg" href={href('/contact')}><Icon name="phone" /> Book a Call</a>
    </div>
  </Hero>
</Layout>
