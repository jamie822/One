---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site.js';
---
<Layout path="/404" title="Page not found">
  <Hero inner={true}>
    <span class="eyebrow" style="color:var(--brand)">404</span>
    <h1>We couldn't find that page</h1>
    <p>It may have moved. Let's get you back on track.</p>
    <div class="hero__actions">
      <a class="btn btn--brand btn--lg" href="/">Back to Home</a>
      <a class="hero__phone" href={`tel:${site.phoneHref}`}><Icon name="phone" /> {site.phone}</a>
    </div>
  </Hero>
</Layout>
