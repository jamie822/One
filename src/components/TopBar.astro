---
import { site } from '../data/site.js';
import Icon from './Icon.astro';
const socials = [
  ['instagram', site.instagram],
  ['facebook', site.facebook],
  ['youtube', site.youtube],
  ['linkedin', site.linkedin],
  ['tiktok', site.tiktok],
];
---
<div class="topbar">
  <div class="container topbar__inner">
    <div class="topbar__group">
      <a href={`tel:${site.phoneHref}`}><Icon name="phone" /> {site.phone}</a>
      <a class="topbar__meta" href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a>
      <span class="topbar__meta" style="display:inline-flex;align-items:center;gap:8px"><Icon name="clock" /> {site.hoursShort}</span>
    </div>
    <div class="topbar__socials">
      {socials.filter(([, url]) => url).map(([name, url]) => (
        <a href={url} target="_blank" rel="noopener" aria-label={name}><Icon name={name} /></a>
      ))}
    </div>
  </div>
</div>
