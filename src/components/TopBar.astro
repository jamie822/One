---
import { site } from '../data/site.js';
import Icon from './Icon.astro';
---
<div class="topbar">
  <div class="container topbar__inner">
    <div class="topbar__group">
      <a href={`tel:${site.phoneHref}`}><Icon name="phone" /> {site.phone}</a>
      <a class="topbar__meta-item" href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a>
      <span class="topbar__group--meta" style="display:inline-flex;align-items:center;gap:8px;color:rgba(255,255,255,.78)"><Icon name="clock" /> {site.hoursShort}</span>
    </div>
    <div class="topbar__socials">
      {site.instagram && <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>}
      {site.facebook && <a href={site.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" /></a>}
      {site.whatsapp && <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" /></a>}
    </div>
  </div>
</div>
