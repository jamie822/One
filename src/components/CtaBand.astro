---
import { site } from '../data/site.js';
import { href } from '../lib/href.js';
import Icon from './Icon.astro';
const {
  title = 'Need an electrician you can rely on?',
  text = `Friendly, qualified and fully insured. Get a free, no-obligation quote for work across ${site.address.locality} and nearby.`,
} = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="cta-band reveal">
      <h2>{title}</h2>
      <p>{text}</p>
      <div class="cta-band__actions">
        <a class="btn btn--brand btn--lg" href={`tel:${site.phoneHref}`}><Icon name="phone" /> Call {site.phone}</a>
        <a class="btn btn--outline-light btn--lg" href={href('/contact')}>Request a Quote</a>
      </div>
    </div>
  </div>
</section>
