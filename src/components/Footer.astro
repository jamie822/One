---
import { site, services } from '../data/site.js';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
const hasStreet = site.address.street && site.address.street.length > 0;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/" style="color:#fff">
          <span class="brand__mark">{site.logoText}</span>
          <span class="brand__name" style="color:#fff">{site.name}<span style="color:rgba(255,255,255,.6)">{site.tagline}</span></span>
        </a>
        <p style="margin-top:16px;max-width:32ch">
          Qualified, insured electricians serving {site.address.locality} and the surrounding areas.
        </p>
        <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram" style="display:inline-flex;gap:8px;align-items:center;margin-top:6px">
          <Icon name="instagram" /> Follow our work
        </a>
      </div>

      <div>
        <h4>Quick links</h4>
        <ul class="footer-links">
          <li><a href="/">Home</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/about">About Us</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </div>

      <div>
        <h4>Get in touch</h4>
        <ul class="footer-links">
          <li><a href={`tel:${site.phoneHref}`}><Icon name="phone" /> {site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a></li>
          <li>
            <Icon name="pin" />
            {hasStreet ? `${site.address.street}, ` : ''}{site.address.locality}, {site.address.postcode}
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} {site.legalName}. All rights reserved.</span>
      <span>{site.accreditations.join(' · ')}</span>
    </div>
  </div>
</footer>
