---
import { site } from '../data/site.js';
import { href } from '../lib/href.js';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
const hasStreet = site.address.street && site.address.street.length > 0;
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href={href('/')} style="margin-bottom:16px">
          <span class="brand__mark">{site.logoText}</span>
          <span class="brand__name">{site.name}<span>Electrical Contractors</span></span>
        </a>
        <p style="max-width:36ch">Qualified, insured electricians serving {site.address.locality} and the surrounding areas — your source for all things electrical.</p>
        <div class="footer-socials">
          {site.instagram && <a href={site.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>}
          {site.facebook && <a href={site.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" /></a>}
          {site.whatsapp && <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" /></a>}
        </div>
      </div>

      <div>
        <h4>Quick links</h4>
        <ul class="footer-links">
          <li><a href={href('/')}>Home</a></li>
          <li><a href={href('/services')}>Services</a></li>
          <li><a href={href('/about')}>About Us</a></li>
          <li><a href={href('/contact')}>Contact</a></li>
        </ul>
      </div>

      <div>
        <h4>Get in touch</h4>
        <ul class="footer-links">
          <li><a href={`tel:${site.phoneHref}`}><Icon name="phone" /> {site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a></li>
          <li><span style="display:inline-flex;gap:10px;align-items:flex-start;color:rgba(255,255,255,.7)"><Icon name="pin" /> {hasStreet ? `${site.address.street}, ` : ''}{site.address.locality}, {site.address.postcode}</span></li>
          <li><span style="display:inline-flex;gap:10px;align-items:center;color:rgba(255,255,255,.7)"><Icon name="clock" /> {site.hoursShort}</span></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} {site.legalName}. All rights reserved.</span>
      <span>{site.accreditations.join(' · ')}</span>
    </div>
  </div>
</footer>
