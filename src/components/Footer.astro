---
import { site } from '../data/site.js';
import { href } from '../lib/href.js';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
const socials = [
  ['instagram', site.instagram],
  ['facebook', site.facebook],
  ['youtube', site.youtube],
  ['linkedin', site.linkedin],
  ['tiktok', site.tiktok],
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a href={href('/')} style="display:inline-block;margin-bottom:16px"><Logo /></a>
        <p class="serif gold" style="font-size:1.15rem;margin:0 0 10px">{site.strapline}</p>
        <p style="max-width:38ch">{site.descriptor} Built by an electrician, for electricians who are ready to get off the tools.</p>
        <div class="footer-socials">
          {socials.filter(([, url]) => url).map(([name, url]) => (
            <a href={url} target="_blank" rel="noopener" aria-label={name}><Icon name={name} /></a>
          ))}
        </div>
      </div>

      <div>
        <h4>Explore</h4>
        <ul class="footer-links">
          <li><a href={href('/')}>Home</a></li>
          <li><a href={href('/story')}>My Story</a></li>
          <li><a href={href('/services')}>What We Do</a></li>
          <li><a href={href('/results')}>Results</a></li>
          <li><a href={href('/packages')}>Packages</a></li>
          <li><a href={href('/contact')}>Contact</a></li>
        </ul>
      </div>

      <div>
        <h4>Get in touch</h4>
        <ul class="footer-links">
          <li><a href={`tel:${site.phoneHref}`}><Icon name="phone" /> {site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a></li>
          <li><span style="display:inline-flex;gap:10px;align-items:center;color:var(--muted)"><Icon name="clock" /> {site.hoursShort}</span></li>
        </ul>
        <a class="btn btn--ghost" href={href('/contact')} style="margin-top:18px">Book a Call <Icon name="arrow" /></a>
      </div>
    </div>

    <div class="footer-bottom">
      <span>&copy; {year} {site.legalName}. All rights reserved.</span>
      <span>{site.tagline}</span>
    </div>
  </div>
</footer>
