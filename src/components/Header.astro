---
import { site } from '../data/site.js';
import { href } from '../lib/href.js';
import Logo from './Logo.astro';
const { path = '' } = Astro.props;
const links = [
  { href: '/', label: 'Home' },
  { href: '/story', label: 'My Story' },
  { href: '/services', label: 'What We Do' },
  { href: '/packages', label: 'Packages' },
  { href: '/contact', label: 'Contact' },
];
const isActive = (h) => (h === '/' ? path === '/' || path === '' : path.startsWith(h));
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href={href('/')} aria-label={`${site.name} home`}><Logo /></a>

    <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false" data-nav-toggle>
      <span></span><span></span><span></span>
    </button>

    <nav class="nav" data-nav>
      {links.map((l) => (
        <a href={href(l.href)} class={isActive(l.href) ? 'is-active' : ''}>{l.label}</a>
      ))}
      <a class="btn btn--gold nav__cta" href={href('/contact')}>Book a Call</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const nav = document.querySelector('[data-nav]');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });
</script>
